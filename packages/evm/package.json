{
  "name": "@gnosis-guild/zodiac-core-modifier-roles",
  "version": "3.0.0",
  "type": "module",
  "description": "A Zodiac modifier that allows avatars to enforce granular, role-based, permissions for attached modules.",
  "directories": {
    "test": "test"
  },
  "types": "./typechain-types/index.ts",
  "exports": {
    ".": {
      "types": "./typechain-types/index.ts",
      "import": "./typechain-types/index.ts"
    },
    "./contracts/*": "./contracts/*"
  },
  "scripts": {
    "build": "hardhat compile",
    "clean": "hardhat clean",
    "test": "hardhat test",
    "deploy:mastercopy": "yarn hardhat deploy:mastercopy --network",
    "verify:mastercopy": "yarn hardhat verify:mastercopy --network",
    "coverage": "hardhat test --coverage",
    "fmt": "yarn fmt:sol && yarn fmt:ts",
    "fmt:sol": "prettier 'contracts/**/*.sol' -w",
    "fmt:ts": "prettier '(test|src)/**/*.ts' -w",
    "prepack": "yarn build",
    "agent:launch": "bash scripts/launch-agent.sh",
    "agent:attach": "bash scripts/attach-agent.sh",
    "agent:stop": "bash scripts/stop-agent.sh"
  },
  "devDependencies": {
    "@gnosis-guild/typechain-ethers-v6": "^0.5.5",
    "@gnosis-guild/zodiac-core": "4.2.0",
    "@nomicfoundation/hardhat-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^3.0.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-keystore": "^3.0.0",
    "@nomicfoundation/hardhat-mocha": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.0",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^3.0.0",
    "@nomicfoundation/ignition-core": "^3.0.0",
    "@types/mocha": "10.0.10",
    "chai": "^5.2.1",
    "eth-provider": "^0.13.7",
    "ethers": "6.16.0",
    "hardhat": "^3.4.5",
    "mocha": "^11.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-solidity": "^1.4.3",
    "typechain": "8.3.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "dotenv": "16.4.7"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  }
}
